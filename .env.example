DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
JWT_SECRET=change-me
# One-time codes for registration + password reset.
#
# Registration is ALWAYS two-step: /api/v1/auth/register rejects any request
# without a code previously issued by /api/v1/auth/register/request-otp. There is
# no flag to disable this.
#
# OTP_PEPPER is a server-side secret mixed into every code digest. When it is
# absent the server falls back to JWT_SECRET, so a stolen database alone cannot
# be used to brute-force codes. Set it explicitly in Production.
# OTP_PEPPER=
#
# AUTH_DEV_SHOW_OTP=true is DEVELOPMENT ONLY. It makes the request endpoints
# return the code in the JSON response so the flow can be tested without a mail
# provider. It is intentionally NOT tied to NODE_ENV, so it can never switch
# itself on in production — set it explicitly and keep it out of Production.
AUTH_DEV_SHOW_OTP=
# Vercel Production: set a random CRON_SECRET of at least 16 characters.
# Vercel sends it as Authorization: Bearer <CRON_SECRET> on scheduled GETs.
# Daily schedule: 22:30 UTC (05:30 ICT), after the US regular close in EDT/EST.
# Blank placeholder rejects cron requests; never commit a real secret.
CRON_SECRET=
# Stock prices use the built-in Yahoo daily-chart provider; no API key is required.
# For Node hosting, configure an external scheduler to GET /api/v1/stock-prices/refresh
# with the Bearer secret at 22:30 UTC. npm start does not run a scheduler.
# Gemini API (W1-1 structured statement analysis). Placeholders only — never commit a real key.
# If GEMINI_API_KEY is absent the server reports "Gemini integration is not configured".
GEMINI_API_KEY=
# Optional. If absent, the server uses its documented default constant (gemini-3.6-flash).
GEMINI_MODEL=
# Supabase Storage — private bucket for Statement PDFs. Placeholders only —
# never commit real values. In auto mode, when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY +
# SUPABASE_STORAGE_BUCKET are all set, uploads/downloads/deletes use the private
# Supabase Storage bucket; otherwise a local filesystem store is used for
# local dev/tests (storage/statements). All Supabase privileged credentials live
# server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Optional storage driver override: "supabase" or "local". Leave empty to auto
# select (supabase when the three variables above are present, else local).
STORAGE_MODE=local
# Node handoff: use STORAGE_MODE=local with a persistent writable storage/statements
# directory. For Supabase, set STORAGE_MODE=supabase and configure all three
# Supabase variables with a private bucket. Leave them blank for local storage.
# npm start reads process environment; load the real environment before starting.
# Node 24 / PowerShell: $env:NODE_OPTIONS='--env-file=.env'
# Run from the repository root. Optional Node HTTP listen port (default 3000).
PORT=3000
# Used by test scripts only. Never point this at production. The test seed and
# test harness will refuse to run if this is not set.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/stax_test
